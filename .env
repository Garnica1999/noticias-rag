# Demo: Milvus del servidor. Para el Milvus local del compose:
# MILVUS_URI=http://localhost:19530
MILVUS_URI=http://192.168.1.100:19530
MILVUS_COLLECTION=rag_full_bge_m3_d1024_v1
SOLR_URL=http://192.168.1.100:8983/solr/noticias
EMBEDDINGS_URL=http://192.168.1.100:11435
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMS=1024
EMBEDDING_HALF=true
EMBEDDINGS_BATCH=32
EMBEDDER=bge
OLLAMA_URL=http://localhost:11435
LLM_MODEL=gemma4:e4b
MAX_CONTEXT_TOKENS=16384
GEMMA4_INPUT_TOKENS=16384
GEMMA4_OUTPUT_TOKENS=100000
TOP_K=10
MIN_SCORE=0.0
PARQUET_PATH=/work/data/documentos_rag.parquet
REQUEST_TIMEOUT=240

RETRIEVER=hybrid_boost
RERANK=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cuda
HYBRID_DENSE=0.5
HYBRID_SPARSE=0.5
UNION_DENSE_K=10
UNION_SPARSE_K=20
SEARCH_EF=800
PROMPT_VERSION=v3

